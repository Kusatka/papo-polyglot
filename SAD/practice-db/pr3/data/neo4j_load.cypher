// Ограничения уникальности по id: одинаковый UUID с PostgreSQL
CREATE CONSTRAINT university_id IF NOT EXISTS FOR (n:University) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT institute_id IF NOT EXISTS FOR (n:Institute) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT department_id IF NOT EXISTS FOR (n:Department) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT specialty_id IF NOT EXISTS FOR (n:Specialty) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT lecturecourse_id IF NOT EXISTS FOR (n:LectureCourse) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT group_id IF NOT EXISTS FOR (n:Group) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT student_id IF NOT EXISTS FOR (n:Student) REQUIRE n.id IS UNIQUE;
UNWIND [{id: "88da7fc5-964d-523f-8d64-78a5c42eef04", name: "МИРЭА — Российский технологический университет", short_name: "РТУ МИРЭА"}] AS r MERGE (n:University {id: r.id}) SET n += r;
UNWIND [{id: "bf36bec4-a09f-510a-8521-460444e2af4e", name: "Институт кибербезопасности и цифровых технологий", short_name: "ИКБ", dean: "Андреев А.В."}, {id: "8bb97c8b-ee41-5cc9-b696-5fb9bd110b23", name: "Институт информационных технологий", short_name: "ИИТ", dean: "Сидоров С.С."}] AS r MERGE (n:Institute {id: r.id}) SET n += r;
UNWIND [{id: "0bc8df6b-96de-57cb-b78c-8c0b99c590dc", name: "Кафедра корпоративных информационных систем", short_name: "КИС", head: "Голубев Д.А."}, {id: "50c128a8-fc87-5405-b499-8b20fa282397", name: "Кафедра программной инженерии", short_name: "КПИ", head: "Иванов И.И."}] AS r MERGE (n:Department {id: r.id}) SET n += r;
UNWIND [{id: "aea4aef1-eafb-5e64-9e7c-d91c531cf987", name: "Бизнес-информатика", code: "38.03.05", degree_level: "bachelor"}, {id: "df0015bb-290e-567b-903f-b6ac17508e1f", name: "Программная инженерия", code: "09.03.04", degree_level: "bachelor"}] AS r MERGE (n:Specialty {id: r.id}) SET n += r;
