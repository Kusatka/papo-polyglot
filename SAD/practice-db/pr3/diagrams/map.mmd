flowchart LR
    PG[("<b>PostgreSQL — master</b><br/>источник истины, ACID<br/>все 13 таблиц:<br/>universities · institutes · departments<br/>specialties · department_specialties<br/>lecture_courses · lectures · lecture_materials<br/>student_groups · students · student_electives<br/>schedule · attendance (20 недельных партиций)")]

    R["<b>Redis — кэш</b> (база №2)<br/>student:{id} — Hash, TTL 2 ч<br/>schedule:{group}:{date} — Hash, TTL 1 ч<br/>today_schedule:{group} — List, до конца дня<br/>attendance:{schedule} — Hash, TTL 30 мин<br/>session:{user} — String JSON, TTL 24 ч"]
    N["<b>Neo4j — граф</b><br/>University → Institute → Department<br/>→ Specialty → LectureCourse<br/>Specialty → Group ← Student<br/>Student –CHOSE→ LectureCourse<br/>Department –TEACHES→ LectureCourse"]
    M["<b>MongoDB — документы</b><br/>lecture_materials: агрегат материалов занятия<br/>(текст, слайды, код, упражнения)<br/>student_groups: группа с составом"]
    E["<b>Elasticsearch — полнотекст</b><br/>индекс lectures: title, annotation,<br/>content_text, tech_requirements<br/>(russian_custom) + метаданные keyword:<br/>lecture_type, tags, specialty_code"]

    PG -- "дубль: карточки студентов,<br/>расписание групп,<br/>текущие отметки" --> R
    PG -- "дубль: иерархия, группы,<br/>студенты, выбор курсов" --> N
    PG -- "дубль: материалы занятий<br/>как один документ" --> M
    PG -- "дубль: тексты и аннотации<br/>для поиска" --> E
