UNWIND [{id: "bc42be9c-5a5e-5b9c-acb7-60407fd6b350", name: "Проектирование архитектуры ПО", semester: 6, total_hours: 144, is_elective: false}, {id: "2853dadd-f264-587f-9556-ac6b8eb35d47", name: "Большие данные и потоковая обработка", semester: 6, total_hours: 108, is_elective: false}, {id: "7fd34c76-ca4b-5235-accc-545e52ff1630", name: "Распределённые системы", semester: 6, total_hours: 108, is_elective: false}, {id: "c0e3c98c-7340-5c61-bdc0-62ffd12703cf", name: "Хранилища данных и OLAP", semester: 6, total_hours: 108, is_elective: false}, {id: "0595cd57-891b-5f79-a6be-cf2d1a94b1e8", name: "Информационная безопасность", semester: 6, total_hours: 72, is_elective: false}, {id: "7c6ff099-7f7e-5949-9b0e-47d6eaeb925f", name: "NoSQL и полиглотное хранение", semester: 6, total_hours: 72, is_elective: true}, {id: "6f844249-f144-52c9-96d7-bf679eec52d0", name: "Бизнес-аналитика", semester: 6, total_hours: 72, is_elective: true}] AS c
