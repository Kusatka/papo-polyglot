{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "russian_custom": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "russian_stop",
            "russian_stemmer"
          ]
        }
      },
      "filter": {
        "russian_stop": {
          "type": "stop",
          "stopwords": "_russian_"
        },
        "russian_stemmer": {
          "type": "stemmer",
          "language": "russian"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "course_id": {
        "type": "keyword"
      },
      "name": {
        "type": "text",
        "analyzer": "russian_custom",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "description": {
        "type": "text",
        "analyzer": "russian_custom"
      },
      "specialty_code": {
        "type": "keyword"
      },
      "department": {
        "type": "keyword"
      },
      "semester": {
        "type": "integer"
      },
      "total_hours": {
        "type": "integer"
      },
      "is_elective": {
        "type": "boolean"
      },
      "tags": {
        "type": "keyword"
      },
      "terms": {
        "type": "keyword"
      }
    }
  }
}