# Пример конфигурации. Перед запуском скопируйте в .env:
#   cp .env.example .env     (Windows PowerShell:  copy .env.example .env)
# Значения демонстрационные — для учебного контура.

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=papo
POSTGRES_USER=papo
POSTGRES_PASSWORD=papo_pass

# ── Redis ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── MongoDB ─────────────────────────────────────────────────────────
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=papo
MONGO_USER=papo
MONGO_PASSWORD=papo_pass

# ── Neo4j ───────────────────────────────────────────────────────────
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=papo_password

# ── ElasticSearch ───────────────────────────────────────────────────
ES_HOST=elasticsearch
ES_PORT=9200
ES_SCHEME=http

# ── JWT / API Gateway ───────────────────────────────────────────────
JWT_SECRET=change-me-super-secret-key-for-papo-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DEMO_USER=admin
DEMO_PASSWORD=admin

# ── Адреса сервисов лаб ─────────────────────────────────────────────
LAB1_URL=http://lab1:8001
LAB2_URL=http://lab2:8002

# ── Параметры генерации данных ──────────────────────────────────────
GEN_GROUPS=34
GEN_SEED=2023
